NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Canonical app URL used for auth email redirects (for example: https://polepost.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Vercel-provided fallback URL if NEXT_PUBLIC_SITE_URL is not set.
NEXT_PUBLIC_VERCEL_URL=
# Optional safety check: if set, must match the project ref from NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
